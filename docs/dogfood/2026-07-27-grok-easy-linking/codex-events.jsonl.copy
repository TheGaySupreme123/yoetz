ct to Yoetz\", default=\"1\")\nsrc/yoetz/cli/setup.py:261:    raw = typer.prompt(\"Select the Codex installation to configure\", default=\"1\")\nsrc/yoetz/cli/setup.py:715:        prompt_provider_endpoint_binding,\nsrc/yoetz/cli/setup.py:821:        written = prompt_provider_endpoint_binding()\nsrc/yoetz/cli/app.py:1086:        prompt_provider_endpoint_binding,\nsrc/yoetz/cli/app.py:1102:            prompt_provider_endpoint_binding()\nsrc/yoetz/cli/observe_hooks.py:758:        # Selective secondary stream reconciliation (path never persisted/disclosed).\nsrc/yoetz/cli/elevated.py:30:    SelectAuthorizationSourceAction,\nsrc/yoetz/cli/elevated.py:281:            await session.send_action(SelectAuthorizationSourceAction(\"secret_reauthentication\"))\ntests/subprocess/test_setup_wizard_cli.py:252:    monkeypatch.setattr(provider_binding, \"prompt_provider_endpoint_binding\", lambda: None)\ntests/subprocess/test_setup_wizard_cli.py:259:    assert \"Select a harness to connect to Yoetz\" in result.stdout\ntests/subprocess/test_setup_wizard_cli.py:261:    assert \"Select the Codex installation to configure\" in result.stdout\ntests/subprocess/test_setup_wizard_cli.py:286:    monkeypatch.setattr(provider_binding, \"prompt_provider_endpoint_binding\", lambda: None)\ntests/subprocess/test_setup_wizard_cli.py:569:    monkeypatch.setattr(binding_module, \"prompt_provider_endpoint_binding\", lambda: None)\nsrc/yoetz/cli/provider_binding.py:33:    \"prompt_provider_endpoint_binding\",\nsrc/yoetz/cli/provider_binding.py:94:def prompt_provider_endpoint_binding(*, path: Path | None = None) -> Path | None:\nsrc/yoetz/cli/provider_binding.py:104:    typer.echo(\"  6  Vercel AI Gateway (OpenAI-compatible Responses)\")\nsrc/yoetz/cli/provider_binding.py:105:    typer.echo(\"  7  Custom OpenAI-compatible HTTPS origin\")\nsrc/yoetz/cli/provider_binding.py:107:    raw = typer.prompt(\"Select\", default=\"s\").strip().lower()\nsrc/yoetz/cli/unlock.py:49:    SelectAuthorizationSourceAction,