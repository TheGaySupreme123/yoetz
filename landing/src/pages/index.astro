---
import "../styles/tokens.css";
import "../styles/landing.css";

const GITHUB = "https://github.com/yoetz/yoetz-core";

// Terminal transcript — colors match the design-system terminal palette.
const faint = "#64748b";
const dim = "#94a3b8";
const bright = "#f8fafc";
const soft = "#cbd5e1";
const light = "#e2e8f0";
const teal = "#2dd4bf";
const glow = "#5eead4";
const amber = "#fbbf24";
const red = "#f87171";
const redSoft = "#fda4af";

type TermLine = {
  pre?: string;
  preC?: string;
  op?: string;
  rest?: string;
  restC?: string;
  finding?: boolean;
  typed?: boolean;
  ts?: number;
  d?: number;
};

const termLines: TermLine[] = [
  { pre: "$", preC: glow, rest: "codex", restC: bright, typed: true, d: 450 },
  { pre: "›", preC: "#7dd3fc", rest: "Refactor the rate limiter. Keep the /limits response shape and make sure tests pass.", restC: light, typed: true, ts: 10, d: 600 },
  { d: 140 },
  { pre: "•", preC: faint, rest: "I'll plan this first and record the obligations in yoetz.", restC: soft, d: 420 },
  { pre: "⚙", preC: teal, op: "yoetz", rest: "start · publish_work — plan, 3 obligations", restC: dim, d: 550 },
  { pre: "⚡", preC: amber, rest: "Edited src/limiter.py  (+118 −74)", restC: dim, d: 340 },
  { pre: "⚡", preC: amber, rest: "Ran pytest — 41 passed", restC: dim, d: 650 },
  { d: 140 },
  { pre: "•", preC: faint, rest: "Tests pass. Checking with yoetz before I claim done.", restC: soft, d: 450 },
  { pre: "⚙", preC: teal, op: "yoetz", rest: "check — 2 findings", restC: amber, d: 550 },
  { pre: "✗", preC: red, rest: "“tests pass” cites a run older than the last edit", restC: redSoft, finding: true, d: 380 },
  { pre: "✗", preC: red, rest: "/limits response shape was never verified", restC: redSoft, finding: true, d: 700 },
  { d: 140 },
  { pre: "•", preC: faint, rest: "Fair catch — fixing, then re-running.", restC: soft, d: 420 },
  { pre: "⚡", preC: amber, rest: "Restored /limits shape · Ran pytest — 43 passed", restC: dim, d: 550 },
  { pre: "⚙", preC: teal, op: "yoetz", rest: "respond · check — clean", restC: dim, d: 380 },
  { pre: "⚙", preC: teal, op: "yoetz", rest: "receipt — deterministic · local-only · 0 unresolved", restC: glow, d: 550 },
  { d: 140 },
  { pre: "▸", preC: teal, rest: "Done — rate limiter refactored, receipt attached.", restC: bright, d: 300 },
];

type HowStep = {
  who: string;
  glyph?: string;
  text: string;
  yoetz?: boolean;
  bad?: boolean;
  good?: boolean;
};

const howSteps: HowStep[] = [
  { who: "YOU", glyph: "›", text: "“Refactor the rate limiter. Keep the /limits response shape.”" },
  { who: "YOUR AGENT", glyph: "⚙", text: "Reads the code, decides on a sliding-window limiter." },
  { who: "YOETZ", yoetz: true, text: "On the record: the plan, plus two promises — keep /limits intact, tests must pass." },
  { who: "YOUR AGENT", glyph: "⚡", text: "Edits limiter.py, runs pytest — 41 passed." },
  { who: "YOUR AGENT", glyph: "⚙", text: "Looks done. Asks Yoetz before claiming it." },
  { who: "YOETZ", yoetz: true, bad: true, text: "Not yet: those tests ran before your last edit — and /limits was never checked." },
  { who: "YOUR AGENT", glyph: "⚡", text: "Re-runs pytest — 42 passed, 1 failed. The /limits shape did break." },
  { who: "YOUR AGENT", glyph: "⚡", text: "Restores the /limits shape, runs pytest again — 43 passed." },
  { who: "YOETZ", yoetz: true, text: "Both promises verified against fresh evidence. Clean." },
  { who: "YOETZ", yoetz: true, text: "Receipt attached — what was promised, done, and checked." },
  { who: "YOU", glyph: "✓", good: true, text: "Get a “done” you can trust." },
];

const roadmap = [
  { name: "Codex", img: "https://github.com/openai.png?size=96", badge: "now", badgeClass: "ds-badge-running", nodeClass: "now" },
  { name: "Claude Code", img: "https://github.com/anthropics.png?size=96", badge: "next", badgeClass: "ds-badge-next", nodeClass: "" },
  { name: "Cursor", img: "https://github.com/getcursor.png?size=96", badge: "later", badgeClass: "ds-badge-later", nodeClass: "" },
];
const roadLinks = ["hot", "warm", ""];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Yoetz — Make sure agents did what they said</title>
    <meta
      name="description"
      content="A local, open-source ledger your agent works against — and an independent check on every claim of done."
    />
    <link rel="icon" href="/assets/yoetz-icon.svg" type="image/svg+xml" />
    <meta property="og:title" content="Yoetz — Make sure agents did what they said" />
    <meta
      property="og:description"
      content="A local, open-source ledger your agent works against — and an independent check on every claim of done."
    />
    <meta property="og:type" content="website" />
    <noscript>
      <style>
        .how-step { opacity: 1; transform: none; }
      </style>
    </noscript>
  </head>
  <body>
    <!-- Hero -->
    <section id="top" class="ds-hero">
      <div class="ds-hero-grid">
        <div>
          <div class="hero-brand">
            <img src="/assets/yoetz-icon.svg" alt="Yoetz" />
            <span>Yoetz</span>
          </div>
          <div class="hero-license">
            <a href={`${GITHUB}/blob/main/LICENSE`} target="_blank" rel="noopener">
              <span class="l">open source</span>
              <span class="r">Apache-2.0</span>
            </a>
          </div>
          <h1 class="ds-h1">
            <span class="line">Make sure agents</span>
            <span class="line grad">did what they said.</span>
          </h1>
          <p class="ds-lead" style="margin-top: 20px;">
            A local, open-source ledger your agent works against — and an
            independent check on every claim of “done”.
          </p>
          <div class="ds-hero-ctas">
            <button class="ds-btn copy-btn" id="copy-install" type="button">
              <span class="prompt">$</span> npx yoetz
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
              <span class="copy-note" id="copy-note"></span>
            </button>
            <a class="ds-btn ds-btn-secondary" href={GITHUB} target="_blank" rel="noopener">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
              View on GitHub
            </a>
          </div>
          <p class="ds-meta-mono" style="margin: 22px 0 0;">Now in Codex · early alpha · no cloud, runs locally</p>
        </div>

        <!-- Mock terminal -->
        <div class="term-card">
          <div class="term-head">
            <div class="term-dots"><span></span><span></span><span></span></div>
            <span class="term-title">codex — ~/packetforge</span>
            <span class="term-pill">yoetz · local</span>
          </div>
          <div class="term-body" id="term">
            {termLines.map((ln) =>
              ln.pre || ln.op || ln.rest ? (
                <div
                  class={`tl${ln.finding ? " tl-finding" : ""}`}
                  data-d={ln.d}
                  data-typed={ln.typed ? "" : undefined}
                  data-ts={ln.ts}
                >
                  <span class="tl-pre" style={`color: ${ln.preC ?? faint};`}>{ln.pre}</span>
                  {ln.op && <span class="tl-op">{ln.op}</span>}
                  <span class="tl-rest" style={`color: ${ln.restC ?? dim};`}>{ln.rest}</span>
                </div>
              ) : (
                <div class="tl tl-gap" data-d={ln.d}></div>
              )
            )}
            <div class="term-cursor-line" id="term-cursor" hidden>
              <span class="tl-pre">$</span>
              <span class="dx-caret"></span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Quickstart -->
    <section id="quickstart" class="ds-cta-dark">
      <div class="ds-cta-glow"></div>
      <div class="ds-cta-inner">
        <span class="ds-kicker ds-kicker-on-dark">Quickstart</span>
        <h2 class="ds-h2 ds-on-dark">Wired into Codex in two minutes</h2>

        <div class="qs-steps">
          <div class="qs-step">
            <span class="qs-num">1</span>
            <div class="qs-body">
              <div class="qs-code"><span class="prompt">$</span> npx yoetz</div>
              <p class="qs-note">Detects Codex, registers the MCP server, installs the skill. Nothing leaves your machine.</p>
            </div>
          </div>

          <div class="qs-step">
            <span class="qs-num">2</span>
            <div class="qs-body">
              <div class="qs-code" style="font-size: 13px; line-height: 1.7;">
                <div class="comment"># ~/.codex/config.toml</div>
                <div><span class="section">[mcp_servers.yoetz]</span></div>
                <div>command = <span class="string">"yoetz"</span></div>
                <div>args = [<span class="string">"mcp"</span>]</div>
              </div>
              <p class="qs-note">The whole integration. Remove the block to uninstall.</p>
            </div>
          </div>

          <div class="qs-step">
            <span class="qs-num">3</span>
            <div class="qs-body">
              <p class="qs-plain">Work as usual. Your agent checks before claiming completion and attaches a receipt.</p>
            </div>
          </div>
        </div>

        <div class="qs-ctas">
          <a class="ds-btn qs-btn-primary" href={GITHUB} target="_blank" rel="noopener">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
            Star on GitHub
          </a>
          <a class="ds-btn qs-btn-ghost" href={`${GITHUB}#readme`} target="_blank" rel="noopener">Read the docs</a>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section id="how" class="ds-section">
      <div class="ds-section-head">
        <span class="ds-kicker">How it works</span>
        <h2 class="ds-h2">An independent ledger between your agent and “done”</h2>
      </div>
      <div class="how-steps" id="how-steps">
        {howSteps.map((s) => (
          <div
            class={[
              "how-step",
              s.yoetz ? "yoetz" : s.who === "YOU" ? "you" : "agent",
              s.bad ? "bad" : "",
              s.good ? "good" : "",
            ]
              .filter(Boolean)
              .join(" ")}
          >
            <span class="how-mark">
              {s.yoetz ? <img src="/assets/yoetz-icon.svg" alt="Yoetz" /> : <span>{s.glyph}</span>}
            </span>
            <div class="how-card">
              <div class="how-who">{s.who}</div>
              <div class="how-text">{s.text}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Harness roadmap -->
    <section id="roadmap" class="roadmap">
      <div class="ds-section-head">
        <span class="ds-kicker">Harnesses</span>
        <h2 class="ds-h2">An open MCP protocol from day one</h2>
        <p class="ds-lead">Any MCP host can plug in today — Codex is the first harness with a first-party integration.</p>
      </div>
      <div class="road">
        {roadmap.map((h, i) => (
          <>
            <div class={`road-node ${h.nodeClass}`}>
              <div class="road-circle">
                <img src={h.img} alt={h.name} loading="lazy" />
              </div>
              <div class="road-name">{h.name}</div>
              <span class={`ds-badge ${h.badgeClass}`}>{h.badge}</span>
            </div>
            <div class={`road-link ${roadLinks[i]}`}></div>
          </>
        ))}
        <div class="road-node open-node">
          <div class="road-circle open">+</div>
          <div class="road-name">Any MCP host</div>
          <span class="ds-badge ds-badge-open">open protocol</span>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="ds-footer">
      <p class="ds-footer-note">
        v0.1 public alpha. Zero network egress by default; semantic review is opt-in, BYO endpoint.
      </p>
      <div class="ds-footer-inner">
        <div class="ds-footer-brand">
          <img src="/assets/yoetz-icon.svg" alt="" />
          <span>© 2026 Yoetz. Apache-2.0.</span>
        </div>
        <div class="ds-footer-links">
          <a href={GITHUB} target="_blank" rel="noopener">GitHub</a>
          <span class="ds-footer-dot"></span>
          <a href={`${GITHUB}/blob/main/SECURITY.md`} target="_blank" rel="noopener">Security</a>
          <span class="ds-footer-dot"></span>
          <a href={`${GITHUB}/blob/main/CONTRIBUTING.md`} target="_blank" rel="noopener">Contributing</a>
          <span class="ds-footer-dot"></span>
          <a href={`${GITHUB}/blob/main/CHANGELOG.md`} target="_blank" rel="noopener">Changelog</a>
        </div>
      </div>
    </footer>

    <script>
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // --- Copy "npx yoetz" ---
      const copyBtn = document.getElementById("copy-install");
      const copyNote = document.getElementById("copy-note");
      let copyTimer: ReturnType<typeof setTimeout>;
      copyBtn?.addEventListener("click", () => {
        navigator.clipboard?.writeText("npx yoetz").catch(() => {});
        if (copyNote) copyNote.textContent = "copied";
        clearTimeout(copyTimer);
        copyTimer = setTimeout(() => {
          if (copyNote) copyNote.textContent = "";
        }, 1600);
      });

      // --- Terminal replay ---
      const term = document.getElementById("term");
      const cursor = document.getElementById("term-cursor");
      if (term && cursor) {
        const lines = Array.from(term.querySelectorAll<HTMLElement>(".tl"));
        if (reduced) {
          cursor.hidden = false;
        } else {
          for (const l of lines) l.hidden = true;
          const scrollEnd = () => {
            term.scrollTop = term.scrollHeight;
          };
          const typeLine = (line: HTMLElement, done: () => void) => {
            const rest = line.querySelector<HTMLElement>(".tl-rest");
            const full = rest?.textContent ?? "";
            const ts = Number(line.dataset.ts || 22);
            const d = Number(line.dataset.d || 300);
            if (!rest || !full) {
              line.hidden = false;
              scrollEnd();
              setTimeout(done, d);
              return;
            }
            rest.textContent = "▌";
            line.hidden = false;
            scrollEnd();
            let j = 0;
            const tick = () => {
              j++;
              rest.textContent = full.slice(0, j) + (j < full.length ? "▌" : "");
              scrollEnd();
              if (j < full.length) setTimeout(tick, ts);
              else setTimeout(done, d);
            };
            setTimeout(tick, 100);
          };
          const play = () => {
            let i = 0;
            const next = () => {
              if (i >= lines.length) {
                cursor.hidden = false;
                scrollEnd();
                return;
              }
              const line = lines[i++];
              if (line.dataset.typed !== undefined) {
                typeLine(line, next);
              } else {
                line.hidden = false;
                scrollEnd();
                setTimeout(next, Number(line.dataset.d || 250));
              }
            };
            next();
          };
          const io = new IntersectionObserver(
            (entries) => {
              if (entries.some((e) => e.isIntersecting)) {
                io.disconnect();
                setTimeout(play, 500);
              }
            },
            { threshold: 0.3 }
          );
          io.observe(term);
        }
      }

      // --- How-it-works staggered reveal ---
      const how = document.getElementById("how-steps");
      if (how) {
        const steps = Array.from(how.querySelectorAll<HTMLElement>(".how-step"));
        if (reduced) {
          for (const s of steps) s.classList.add("shown");
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              if (entries.some((e) => e.isIntersecting)) {
                io.disconnect();
                steps.forEach((s, i) => {
                  setTimeout(() => s.classList.add("shown"), 300 + i * 850);
                });
              }
            },
            { threshold: 0.25 }
          );
          io.observe(how);
        }
      }
    </script>
  </body>
</html>
