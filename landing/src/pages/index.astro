---
import "../styles/tokens.css";
import "../styles/landing.css";
import landingPackage from "../../package.json";

const SITE = "https://yoetz.dev";
const GITHUB = "https://github.com/TheGaySupreme123/yoetz";
const PYPI = "https://pypi.org/project/yoetz/";
const NPM = "https://www.npmjs.com/package/yoetz";
const DOCS = `${GITHUB}/tree/main/docs/usage`;
const CONTACT_EMAIL = "[YOUR EMAIL]";
const RELEASES = `${GITHUB}/releases`;
const VERSION = landingPackage.version;
// Unpinned on purpose: the site must never name a version PyPI does not have (a pinned
// 0.2.0 shipped once and failed every PyPI install). uv resolves the latest release and
// fetches Python 3.14 itself, whatever other Pythons the machine has. The package keeps
// its `yoetz` name on PyPI and npm until the rename ships there.
const INSTALL_COMMAND = "uv tool install --managed-python --python 3.14.6 yoetz";
const NPM_COMMAND = "npx yoetz";
const AGENT_PROMPT = `I want to install FinishUP (${GITHUB}). Start by fetching its agent install guide and follow it exactly:

curl -fsSL https://raw.githubusercontent.com/TheGaySupreme123/yoetz/main/docs/usage/agent-start.md

It tells you what to run yourself, what to ask me, and where to hand me the terminal. If your sandbox blocks that fetch, ask me to approve it or to paste the guide. Then help me through the CLI: setup's questions are mine to answer, so ask me each one and wait, and show me any proposed change before it is applied.`;
const TITLE = "FinishUP: agents start, FinishUP finishes";
const DESCRIPTION =
  "FinishUP checks what your coding agents actually finished and tells you what is left. Open source, fully local, free. First-party for Codex, Claude Code, and Cursor.";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: "FinishUP",
  description: DESCRIPTION,
  url: SITE,
  codeRepository: GITHUB,
  programmingLanguage: "Python",
  version: VERSION,
  license: "https://www.apache.org/licenses/LICENSE-2.0",
};

// The scroll story: one scene per screen, in order. `screens` is how many viewport
// heights the scene spans; the sun rises across three so each stop gets its own line.
const plan = [
  ["hero", 1],
  ["alone", 1],
  ["swarm", 1],
  ["robot", 3],
  ["sun", 3],
  ["end", 1],
];

// The sunrise is a benchmark: one model on Codex alone, then with Local FinishUP, then
// with AI-powered FinishUP. Fill these in from the run; the page shows them as given.
// The three scores are drawn in dots beside the sun (see particles.js); 60/70/80 are
// stand-ins until the run's numbers are supplied.
const BENCH = { model: "GPT 6.1 Sol", suite: "DeepSWE", scores: ["60", "70", "80"] };
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={`${SITE}/`} />
    <link rel="icon" href="/assets/finishup-mark.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/assets/finishup-mark.svg" />
    <meta name="theme-color" content="#fafdf9" />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${SITE}/`} />
    <meta property="og:site_name" content="FinishUP" />
    <meta property="og:image" content={`${SITE}/assets/og.png`} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={`${SITE}/assets/og.png`} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline type="application/json" id="story-plan" set:html={JSON.stringify(plan)} />
    <script is:inline type="application/json" id="bench-scores" set:html={JSON.stringify(BENCH.scores)} />
  </head>
  <body>
    <header class="nav">
      <div class="nav-inner">
        <a class="lockup" href="#top" aria-label="FinishUP home">
          <img src="/assets/finishup-mark.svg" alt="" width="30" height="30" />
          <span>FinishUP</span>
        </a>
        <nav class="nav-links" aria-label="Site">
          <a class="lnk" href={DOCS} target="_blank" rel="noopener">Docs</a>
          <a class="lnk" href={GITHUB} target="_blank" rel="noopener">GitHub</a>
          <button class="btn sm add-agent" type="button" data-prompt={AGENT_PROMPT}>Add to your agent</button>
        </nav>
      </div>
    </header>

    <main>
      <div class="story" id="story">
        <div class="stage" aria-hidden="true">
          <canvas id="particles"></canvas>
        </div>

        <div class="scenes">
          <section id="top" class="scene hero" data-scene="hero">
            <p class="stanza center hero-top">We use agents to do</p>
            <div class="hero-bottom">
              <p class="stanza center"><span class="nowrap"><svg class="fup-mark" viewBox="0 0 240 240" fill="none" aria-hidden="true"><path d="M190 150V190a20 20 0 0 1-20 20H50a20 20 0 0 1-20-20V70a20 20 0 0 1 20-20h70" stroke="#064E3B" stroke-width="36" stroke-linecap="round" stroke-linejoin="round" /><path d="M112 72l38 38 78-80" stroke="#10B981" stroke-width="34" stroke-linecap="round" stroke-linejoin="round" /></svg>FinishUP</span> <span class="accent">makes sure they do it.</span></p>
              <div class="actions">
                <button class="btn add-agent" type="button" data-prompt={AGENT_PROMPT}>Add to your agent</button>
                <a class="btn quiet" href={GITHUB} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z" /></svg> Visit us on GitHub</a>
              </div>
            </div>
          </section>

          <section id="alone" class="scene" data-scene="alone">
            <p class="stanza copy-right">We used to work alone. <span class="fade">Slowly.</span></p>
          </section>

          <section class="scene" data-scene="swarm">
            <div class="copy-right">
              <p class="eyebrow">8 agents · 1 human</p>
              <p class="stanza">Now agents work. <span class="fade">We manage more.</span></p>
            </div>
          </section>

          <section id="agents" class="scene" data-scene="robot">
            <p class="stanza copy-right">But agents aren't human. <span class="fade">They drift. They forget.</span></p>
          </section>

          <section class="scene" data-scene="robot">
            <p class="stanza copy-right">FinishUP checks what they did.</p>
          </section>

          <section class="scene" data-scene="robot">
            <div class="copy-right">
              <p class="eyebrow done">12 checks passed · 2 left</p>
              <p class="stanza">And makes them finish the work.</p>
            </div>
          </section>

          <section id="benchmark" class="scene" data-scene="sun">
            <div class="copy-right wide">
              <p class="eyebrow">Score on {BENCH.suite}</p>
              <p class="stanza">{BENCH.model} on <span class="nowrap"><span class="tag"><img src="/assets/openai.svg" alt="" width="22" height="22" />Codex</span>,</span> scored on <span class="nowrap"><span class="tag wordmark">{BENCH.suite}</span>.</span></p>
            </div>
          </section>

          <section id="local" class="scene" data-scene="sun">
            <div class="copy-right wide">
              <p class="eyebrow">Score on {BENCH.suite}</p>
              <p class="stanza">{BENCH.model} on <span class="nowrap"><span class="tag"><img src="/assets/openai.svg" alt="" width="22" height="22" />Codex</span>,</span> scored on <span class="nowrap"><span class="tag wordmark">{BENCH.suite}</span></span> <span class="nowrap">with <svg class="fup-mark" viewBox="0 0 240 240" fill="none" aria-hidden="true"><path d="M190 150V190a20 20 0 0 1-20 20H50a20 20 0 0 1-20-20V70a20 20 0 0 1 20-20h70" stroke="#064E3B" stroke-width="36" stroke-linecap="round" stroke-linejoin="round" /><path d="M112 72l38 38 78-80" stroke="#10B981" stroke-width="34" stroke-linecap="round" stroke-linejoin="round" /></svg>FinishUP</span> <span class="dot-word short" aria-label="Local" role="img"></span></p>
            </div>
          </section>

          <section id="ai" class="scene" data-scene="sun">
            <div class="copy-right wide">
              <p class="eyebrow">Score on {BENCH.suite}</p>
              <p class="stanza">{BENCH.model} on <span class="nowrap"><span class="tag"><img src="/assets/openai.svg" alt="" width="22" height="22" />Codex</span>,</span> scored on <span class="nowrap"><span class="tag wordmark">{BENCH.suite}</span></span> <span class="nowrap">with <svg class="fup-mark" viewBox="0 0 240 240" fill="none" aria-hidden="true"><path d="M190 150V190a20 20 0 0 1-20 20H50a20 20 0 0 1-20-20V70a20 20 0 0 1 20-20h70" stroke="#064E3B" stroke-width="36" stroke-linecap="round" stroke-linejoin="round" /><path d="M112 72l38 38 78-80" stroke="#10B981" stroke-width="34" stroke-linecap="round" stroke-linejoin="round" /></svg>FinishUP</span> <span class="dot-word long" aria-label="AI-powered" role="img"></span></p>
            </div>
          </section>

          <section id="end" class="scene foot" data-scene="end">
            <div class="copy-center">
              <h2 class="display" style="font-size: clamp(36px, 5vw, 64px)">All of this<br /><strong>for free.</strong></h2>
              <p class="stanza center sub">Open source, working locally on your computer.</p>
              <div class="actions">
                <button class="btn add-agent" type="button" data-prompt={AGENT_PROMPT}>Add to your agent</button>
                <a class="btn quiet" href={GITHUB} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/></svg> GitHub</a>
              </div>
            </div>
          </section>
        </div>
      </div>

      <section id="install" class="install">
        <div class="install-inner">
          <div>
            <p class="eyebrow">Install</p>
            <h2>Two minutes. Then it runs beside your agent.</h2>
            <p class="lead">Setup asks a few questions in your terminal and connects your host. The package is still published as <code>yoetz</code> until the rename reaches PyPI and npm.</p>
            <div class="hosts" aria-label="Officially supported agents">
              <span>Works with</span>
              <img src="/assets/openai.svg" alt="Codex" title="Codex" />
              <img src="/assets/claude.svg" alt="Claude Code" title="Claude Code" />
              <img src="/assets/cursor.svg" alt="Cursor" title="Cursor" />
            </div>
          </div>
          <div class="cmds">
            <button class="cmd copy-cmd" type="button" data-command={INSTALL_COMMAND} aria-label="Copy the uv install command">
              <span class="lbl">uv</span>
              <code>{INSTALL_COMMAND}</code>
              <span class="copy" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg></span>
            </button>
            <button class="cmd copy-cmd" type="button" data-command={NPM_COMMAND} aria-label="Copy the npx install command">
              <span class="lbl">npm</span>
              <code>{NPM_COMMAND}</code>
              <span class="copy" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg></span>
            </button>
            <p class="eyebrow">Needs uv · fetches its own Python · Apache-2.0</p>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <a class="lockup" href="#top" aria-label="FinishUP home">
          <img src="/assets/finishup-mark.svg" alt="" width="26" height="26" />
          <span>FinishUP</span>
        </a>
        <nav class="footer-links" aria-label="Footer">
          <a href={DOCS} target="_blank" rel="noopener">Docs</a>
          <a href={`mailto:${CONTACT_EMAIL}`}>Contact us</a>
          <a href={GITHUB} target="_blank" rel="noopener">GitHub</a>
        </nav>
        <span class="footer-meta">© 2026 FinishUP</span>
      </div>
    </footer>

    <div class="toast" id="toast" role="status" aria-live="polite" hidden>
      <span class="ok" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg></span>
      <div>
        <p id="toast-title">Copied.</p>
        <p class="sub" id="toast-sub"></p>
      </div>
      <button class="close" type="button" id="toast-close" aria-label="Dismiss"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12" /></svg></button>
    </div>

    <script>
      import { mountParticles } from "../scripts/particles.js";

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // --- The artwork follows the scroll ---
      const canvas = document.getElementById("particles") as HTMLCanvasElement | null;
      const story = document.getElementById("story");
      const planEl = document.getElementById("story-plan");
      const plan: [string, number][] = planEl ? JSON.parse(planEl.textContent || "[]") : [];
      if (canvas && story && plan.length) {
        const narrow = window.innerWidth < 720;
        const scoresEl = document.getElementById("bench-scores");
        const scores: string[] = scoresEl ? JSON.parse(scoresEl.textContent || "[]") : [];
        const art = mountParticles(canvas, { count: narrow ? 2600 : 5200, reducedMotion: reduced, scores });
        let raf = 0;
        let last = "";
        const slot = document.getElementById("pc-slot");
        const tiers = Array.from(document.querySelectorAll<HTMLElement>(".dot-word"));
        const update = () => {
          raf = 0;
          const vh = window.innerHeight || 900;
          if (slot) {
            const r = slot.getBoundingClientRect();
            const c = canvas.getBoundingClientRect();
            art.setAnchor(r.left + r.width / 2 - c.left, r.top + r.height / 2 - c.top);
          }
          if (tiers.length) {
            // the tier slot nearest the middle of the viewport is the one being read
            const c = canvas.getBoundingClientRect();
            let best: DOMRect | null = null;
            for (const el of tiers) {
              const r = el.getBoundingClientRect();
              if (!best || Math.abs(r.top + r.height / 2 - vh / 2) < Math.abs(best.top + best.height / 2 - vh / 2)) best = r;
            }
            if (best) art.setTier(best.left + best.width / 2 - c.left, best.top + best.height / 2 - c.top, best.width, best.height);
          }
          const top = -story.getBoundingClientRect().top;
          const screens = (top + vh * 0.5) / vh;
          let acc = 0;
          let form = plan[plan.length - 1][0];
          let phase = 1;
          for (let i = 0; i < plan.length; i++) {
            const [name, len] = plan[i];
            if (screens < acc + len || i === plan.length - 1) {
              form = name;
              phase = Math.max(0, Math.min(1, (screens - acc) / len));
              break;
            }
            acc += len;
          }
          phase = Math.round(phase * 100) / 100;
          const key = form + ":" + phase;
          if (key !== last) {
            last = key;
            art.setScene(form, phase);
          }
        };
        const onScroll = () => {
          if (!raf) raf = requestAnimationFrame(update);
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll);
        update();
      }

      // --- Copy: the agent prompt, or an install command ---
      const toast = document.getElementById("toast");
      const toastTitle = document.getElementById("toast-title");
      const toastSub = document.getElementById("toast-sub");
      const toastClose = document.getElementById("toast-close");
      let hideTimer = 0;
      async function copyText(text: string): Promise<boolean> {
        if (!text) return false;
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          return false;
        }
      }
      function show(title: string, sub: string) {
        if (!toast || !toastTitle || !toastSub) return;
        toastTitle.textContent = title;
        toastSub.textContent = sub;
        toast.hidden = false;
        window.clearTimeout(hideTimer);
        hideTimer = window.setTimeout(() => { toast.hidden = true; }, 9000);
      }
      toastClose?.addEventListener("click", () => { if (toast) toast.hidden = true; });
      for (const el of Array.from(document.querySelectorAll<HTMLButtonElement>(".add-agent"))) {
        el.addEventListener("click", async () => {
          const ok = await copyText(el.dataset.prompt ?? "");
          show(
            ok ? "Copied. Paste it into your agent." : "Copy blocked by the browser.",
            ok ? "Codex, Claude Code or Cursor fetch the install guide and walk you through setup. Or install yourself below." : "Scroll to Install and copy a command instead.",
          );
          if (!ok) document.getElementById("install")?.scrollIntoView({ behavior: reduced ? "auto" : "smooth" });
        });
      }
      for (const el of Array.from(document.querySelectorAll<HTMLButtonElement>(".copy-cmd"))) {
        el.addEventListener("click", async () => {
          const cmd = el.dataset.command ?? "";
          const ok = await copyText(cmd);
          show(
            ok ? "Copied. Run it in your terminal." : "Copy blocked by the browser.",
            ok ? "Then run `yoetz` to start setup and answer its questions. About two minutes." : cmd,
          );
        });
      }
    </script>
  </body>
</html>
