    <script>
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // --- Install tabs ---
      const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".inst-tab:not(.agent)"));
      const panels = Array.from(document.querySelectorAll<HTMLElement>(".inst-panel"));
      for (const tab of tabs) {
        tab.addEventListener("click", () => {
          for (const t of tabs) {
            t.classList.toggle("active", t === tab);
            t.setAttribute("aria-pressed", t === tab ? "true" : "false");
          }
          for (const p of panels) p.classList.toggle("active", p.dataset.key === tab.dataset.key);
        });
      }

      // --- Copy: agent setup prompt ---
      const agentBtn = document.getElementById("agent-copy");
      const agentLabel = document.getElementById("agent-copy-label");
      let agentTimer: ReturnType<typeof setTimeout>;
      agentBtn?.addEventListener("click", () => {
        navigator.clipboard?.writeText(agentBtn.dataset.command ?? "").catch(() => {});
        if (agentLabel) agentLabel.textContent = "Copied to your clipboard";
        agentBtn.classList.add("copied");
        clearTimeout(agentTimer);
        agentTimer = setTimeout(() => {
          if (agentLabel) agentLabel.textContent = "Set up with your agent";
          agentBtn.classList.remove("copied");
        }, 2000);
      });

      // --- Copy: install commands ---
      for (const btn of document.querySelectorAll<HTMLButtonElement>(".inst-cmd")) {
        const note = btn.querySelector<HTMLElement>(".copy-note");
        let t: ReturnType<typeof setTimeout>;
        btn.addEventListener("click", () => {
          navigator.clipboard?.writeText(btn.dataset.command ?? "").catch(() => {});
          if (note) note.textContent = "copied";
          clearTimeout(t);
          t = setTimeout(() => {
            if (note) note.textContent = "";
          }, 1600);
        });
      }

      // --- Terminal replay ---
      const term = document.getElementById("term");
      const cursor = document.getElementById("term-cursor");
      if (term && cursor) {
        const lines = Array.from(term.querySelectorAll<HTMLElement>(".tl"));
        if (reduced) {
          cursor.hidden = false;
        } else {
          for (const l of lines) l.hidden = true;
          const scrollEnd = () => {
            term.scrollTop = term.scrollHeight;
          };
          const typeLine = (line: HTMLElement, done: () => void) => {
            const rest = line.querySelector<HTMLElement>(".tl-rest");
            const full = rest?.textContent ?? "";
            const ts = Number(line.dataset.ts || 22);
            const d = Number(line.dataset.d || 300);
            if (!rest || !full) {
              line.hidden = false;
              scrollEnd();
              setTimeout(done, d);
              return;
            }
            rest.textContent = "▌";
            line.hidden = false;
            scrollEnd();
            let j = 0;
            const tick = () => {
              j++;
              rest.textContent = full.slice(0, j) + (j < full.length ? "▌" : "");
              scrollEnd();
              if (j < full.length) setTimeout(tick, ts);
              else setTimeout(done, d);
            };
            setTimeout(tick, 100);
          };
          const play = () => {
            let i = 0;
            const next = () => {
              if (i >= lines.length) {
                cursor.hidden = false;
                scrollEnd();
                return;
              }
              const line = lines[i++];
              if (line.dataset.typed !== undefined) {
                typeLine(line, next);
              } else {
                line.hidden = false;
                scrollEnd();
                setTimeout(next, Number(line.dataset.d || 250));
              }
            };
            next();
          };
          const io = new IntersectionObserver(
            (entries) => {
              if (entries.some((e) => e.isIntersecting)) {
                io.disconnect();
                setTimeout(play, 500);
              }
            },
            { threshold: 0.3 }
          );
          io.observe(term);
        }
      }

      // --- Footer receipt easter egg: the visitor's own session ---
      const rcDate = document.getElementById("rc-date");
      const rcActor = document.getElementById("rc-actor");
      const rcTz = document.getElementById("rc-tz");
      const rcTime = document.getElementById("rc-time");
      if (rcDate && rcActor && rcTz && rcTime) {
        const now = new Date();
        rcDate.textContent = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
        const ua = navigator.userAgent;
        const browser = /edg\//i.test(ua) ? "edge" : /firefox/i.test(ua) ? "firefox" : /chrome|crios/i.test(ua) ? "chrome" : /safari/i.test(ua) ? "safari" : "browser";
        const os = /iphone|ipad/i.test(ua) ? "ios" : /android/i.test(ua) ? "android" : /mac/i.test(ua) ? "macos" : /win/i.test(ua) ? "windows" : /linux/i.test(ua) ? "linux" : "somewhere";
        rcActor.textContent = `visitor:${browser}_on_${os}`;
        try {
          rcTz.textContent = `${now.toTimeString().slice(0, 5)} · ${Intl.DateTimeFormat().resolvedOptions().timeZone}`;
        } catch {
          rcTz.textContent = now.toTimeString().slice(0, 5);
        }
        const update = () => {
          rcTime.textContent = `${Math.max(1, Math.round(performance.now() / 1000))}s`;
        };
        update();
        setInterval(update, 1000);
      }

      // --- Flow staggered reveal ---
      const flow = document.getElementById("flow");
      if (flow) {
        const steps = Array.from(flow.querySelectorAll<HTMLElement>(".fl-phase"));
        if (reduced) {
          for (const s of steps) s.classList.add("shown");
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              if (entries.some((e) => e.isIntersecting)) {
                io.disconnect();
                steps.forEach((s, i) => {
                  setTimeout(() => s.classList.add("shown"), 200 + i * 140);
                });
              }
            },
            { threshold: 0.08 }
          );
          io.observe(flow);
        }
      }
    </script>
  </body>
</html>
