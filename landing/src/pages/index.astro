---
import "../styles/tokens.css";
import "../styles/landing.css";
import landingPackage from "../../package.json";

const SITE = "https://yoetz.dev";
const GITHUB = "https://github.com/TheGaySupreme123/yoetz";
const PYPI = "https://pypi.org/project/yoetz/";
const NPM = "https://www.npmjs.com/package/yoetz";
const DOCS = `${GITHUB}/tree/main/docs/usage`;
const CONTACT_EMAIL = "[YOUR EMAIL]";
const PAPER_URL = "[PAPER URL]";
const RELEASES = `${GITHUB}/releases`;
const VERSION = landingPackage.version;
const AGENT_PROMPT = `I want to install FinishUP (${GITHUB}). Start by fetching its agent install guide and follow it exactly:

curl -fsSL https://raw.githubusercontent.com/TheGaySupreme123/yoetz/main/docs/usage/agent-start.md

It tells you what to run yourself, what to ask me, and where to hand me the terminal. If your sandbox blocks that fetch, ask me to approve it or to paste the guide. Then help me through the CLI: setup's questions are mine to answer, so ask me each one and wait, and show me any proposed change before it is applied.`;
const TITLE = "FinishUP: agents start, FinishUP finishes";
const DESCRIPTION =
  "FinishUP checks what your coding agents actually finished and tells you what is left. Open source, fully local, free. First-party for Codex, Claude Code, and Cursor.";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: "FinishUP",
  description: DESCRIPTION,
  url: SITE,
  codeRepository: GITHUB,
  programmingLanguage: "Python",
  version: VERSION,
  license: "https://www.apache.org/licenses/LICENSE-2.0",
};

// The scroll story: one scene at a time, in order. `screens` is how many viewport
// heights the scene spans: a beat and a half for each of the first two lines, 1.2 for each
// of the robot's three, and three for the sunrise so each stop gets its own line.
const plan = [
  ["hero", 0.82],
  ["alone", 1.5],
  ["swarm", 1.5],
  ["robot", 3.6],
  ["sun", 3],
  ["end", 1],
];
// Extra screens the finished lockup holds, frozen, before the footer scrolls in.
const END_HOLD = 0.6;
const STORY_SCREENS = plan.reduce((sum, [, len]) => sum + (len as number), 0) + END_HOLD;

// The sunrise is a benchmark: one model on Codex alone, then with FinishUP's AI-powered
// review. Fill these in from the run; the page shows them as given. The two scores are
// drawn in dots beside the sun (see particles.js); 60/80 are stand-ins until the run's
// numbers are supplied.
const BENCH = { model: "GPT 6.1 Sol", suite: "DeepSWE", scores: ["60", "80"] };
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={`${SITE}/`} />
    <link rel="icon" href="/assets/finishup-mark.png" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/finishup-mark.png" />
    <meta name="theme-color" content="#fafdf9" />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${SITE}/`} />
    <meta property="og:site_name" content="FinishUP" />
    <meta property="og:image" content={`${SITE}/assets/og.png`} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={`${SITE}/assets/og.png`} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline type="application/json" id="story-plan" set:html={JSON.stringify(plan)} />
    <script is:inline type="application/json" id="bench-scores" set:html={JSON.stringify(BENCH.scores)} />
  </head>
  <body>
    <header class="nav">
      <div class="nav-inner">
        <a class="lockup" href="#top" aria-label="FinishUP home"><img src="/assets/finishup-lockup.png" alt="FinishUP" height="32" /></a>
        <nav class="nav-links" aria-label="Site">
          <a class="lnk" href={DOCS} target="_blank" rel="noopener">Docs</a>
          <a class="lnk" href={GITHUB} target="_blank" rel="noopener">GitHub</a>
          <button class="btn sm add-agent" type="button" data-prompt={AGENT_PROMPT}>Add to your agent</button>
        </nav>
      </div>
    </header>

    <main>
      <div class="story" id="story">
        <div class="stage">
          <canvas id="particles" aria-hidden="true"></canvas>
          <div class="copies">
          <div class="copy hero on" data-copy="hero">
            <p class="stanza center hero-top">We use agents for</p>
            <div class="hero-bottom">
              <p class="stanza center"><span class="nowrap"><img class="fup-mark" src="/assets/finishup-mark.png" alt="" />FinishUP</span> <span class="accent">makes sure they do it.</span></p>
              <div class="actions">
                <button class="btn add-agent" type="button" data-prompt={AGENT_PROMPT}>Add to your agent</button>
                <a class="btn quiet" href={GITHUB} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z" /></svg> Visit our GitHub</a>
              </div>
            </div>
          </div>
          <div class="copy side" data-copy="alone">
            <p class="stanza copy-right">We used to work alone. <span class="fade">Slowly.</span></p>
          </div>
          <div class="copy side" data-copy="swarm">
            <div class="copy-right">
              <p class="stanza">Now agents work. <span class="fade">We manage more.</span></p>
            </div>
          </div>
          <div class="copy side" data-copy="robot1">
            <p class="stanza copy-right">But agents aren't human. <span class="fade">They drift. They forget.</span></p>
          </div>
          <div class="copy side" data-copy="robot2">
            <p class="stanza copy-right">FinishUP checks what they did.</p>
          </div>
          <div class="copy side" data-copy="robot3">
            <div class="copy-right">
              <p class="stanza">And makes them finish the work.</p>
            </div>
          </div>
          <div class="copy side" data-copy="bench">
              <div class="copy-right wide">
                <p class="stanza">We tested {BENCH.model} on <span class="nowrap"><span class="tag"><img src="/assets/openai.svg" alt="" width="22" height="22" />Codex</span>,</span> scored on <span class="nowrap"><span class="tag wordmark">{BENCH.suite}</span><span class="bench-dot" id="bench-dot">.</span></span> <span class="nowrap reveal" id="bench-with">with <img class="fup-mark" src="/assets/finishup-mark.png" alt="" />FinishUP</span><span class="dot-word" aria-label="AI-powered" role="img"></span></p>
                <a class="paper" href={PAPER_URL} target="_blank" rel="noopener">Read the full paper <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg></a>
              </div>
          </div>
          <div class="copy foot" data-copy="end">
            <div class="copy-center">
              <h2 class="display" style="font-size: clamp(36px, 5vw, 64px)">All of this<br /><strong>for free.</strong></h2>
              <p class="stanza center sub">Open source, working locally on your computer.</p>
              <div class="actions">
                <button class="btn add-agent" type="button" data-prompt={AGENT_PROMPT}>Add to your agent</button>
                <a class="btn quiet" href={GITHUB} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/></svg> GitHub</a>
              </div>
            </div>
          </div>
          </div>
        </div>
        <div class="spacer" aria-hidden="true" style={`height: ${STORY_SCREENS * 100}vh; height: ${STORY_SCREENS * 100}svh`}></div>
      </div>

    </main>

    <footer class="footer">
      <div class="footer-inner">
        <a class="lockup" href="#top" aria-label="FinishUP home"><img src="/assets/finishup-lockup.png" alt="FinishUP" height="28" /></a>
        <nav class="footer-links" aria-label="Footer">
          <a href={DOCS} target="_blank" rel="noopener">Docs</a>
          <a href={`mailto:${CONTACT_EMAIL}`}>Contact us</a>
          <a href={GITHUB} target="_blank" rel="noopener">GitHub</a>
        </nav>
        <span class="footer-meta">© 2026 FinishUP</span>
      </div>
    </footer>

    <div class="toast" id="toast" role="status" aria-live="polite" hidden>
      <span class="ok" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg></span>
      <div>
        <p id="toast-title">Copied.</p>
        <p class="sub" id="toast-sub"></p>
      </div>
      <button class="close" type="button" id="toast-close" aria-label="Dismiss"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12" /></svg></button>
    </div>

    <script>
      import { mountParticles } from "../scripts/particles.js";

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // --- The artwork follows the scroll ---
      const canvas = document.getElementById("particles") as HTMLCanvasElement | null;
      const story = document.getElementById("story");
      const planEl = document.getElementById("story-plan");
      const plan: [string, number][] = planEl ? JSON.parse(planEl.textContent || "[]") : [];
      if (canvas && story && plan.length) {
        const narrow = window.innerWidth < 720;
        const scoresEl = document.getElementById("bench-scores");
        const scores: string[] = scoresEl ? JSON.parse(scoresEl.textContent || "[]") : [];
        const art = mountParticles(canvas, { count: narrow ? 4500 : 9000, reducedMotion: reduced, scores, plan });
        let raf = 0;
        let last = "";
        const slot = document.getElementById("pc-slot");
        const tiers = Array.from(document.querySelectorAll<HTMLElement>(".dot-word"));
        const benchWith = document.getElementById("bench-with");
        const copies = Array.from(document.querySelectorAll<HTMLElement>(".copy"));
        // where each scene starts, in screens; the copy beats are derived from the same plan
        const start: Record<string, [number, number]> = {};
        let acc = 0;
        for (const [name, len] of plan) { start[name] = [acc, len]; acc += len; }
        const robot = start.robot ?? [0, 3];
        const COPY_AT: [string, number][] = [
          ["hero", 0],
          ["alone", start.alone?.[0] ?? 0],
          ["swarm", start.swarm?.[0] ?? 0],
          ["robot1", robot[0]],
          ["robot2", robot[0] + robot[1] / 3],
          ["robot3", robot[0] + (2 * robot[1]) / 3],
          ["bench", start.sun?.[0] ?? 0],
          ["end", start.end?.[0] ?? 0],
        ];
        const byCopy: Record<string, HTMLElement> = {};
        for (const el of copies) if (el.dataset.copy) byCopy[el.dataset.copy] = el;
        const ease = (v: number) => { const u = Math.max(0, Math.min(1, v)); return u * u * (3 - 2 * u); };
        const benchDot = document.getElementById("bench-dot");
        // screens into the story with the page at the very top: where the hero rests
        const rest = (-(story.getBoundingClientRect().top + window.scrollY) + (window.innerHeight || 900) * 0.5) / (window.innerHeight || 900);
        const update = () => {
          raf = 0;
          const vh = window.innerHeight || 900;
          const top = -story.getBoundingClientRect().top;
          const screens = (top + vh * 0.5) / vh;
          // One line at a time, timed by the scroll itself: the outgoing line is gone before
          // the next fades in, and the dots change shape in the empty moment between.
          COPY_AT.forEach(([name, at], k) => {
            const el = byCopy[name];
            if (!el) return;
            const next = k + 1 < COPY_AT.length ? COPY_AT[k + 1][1] : Infinity;
            const fadeIn = k === 0 ? 1 : ease((screens - (at + 0.05)) / 0.17);
            const fadeOut = next === Infinity ? 1 : 1 - ease((screens - (next - 0.22)) / 0.17);
            const opacity = Math.min(fadeIn, fadeOut);
            // each line drifts gently upward while it is on screen; the hero's starts with
            // the first scroll
            const from = k === 0 ? rest : at + 0.05;
            const to = next === Infinity ? from + 1 : next - 0.05;
            const drift = (k === 0 ? 0 : 12) - 24 * Math.max(0, Math.min(1, (screens - from) / Math.max(0.01, to - from)));
            el.style.opacity = opacity.toFixed(3);
            el.style.transform = reduced ? "none" : `translateY(${((fadeOut - fadeIn) * 18 + drift).toFixed(1)}px)`;
            el.classList.toggle("on", opacity > 0.5);
          });
          // the benchmark copy stays put; "with FinishUP" appears at the second stop
          if (benchWith && start.sun) {
            const bp = (screens - start.sun[0]) / start.sun[1];
            benchWith.classList.toggle("on", bp >= 0.5);
            benchDot?.classList.toggle("off", bp >= 0.5);
          }
          const key = String(Math.round(screens * 400) / 400);
          if (key !== last) {
            last = key;
            art.setScroll(screens);
          }
        };
        // the slots the artwork draws into move as fonts load and copy fades, so they are
        // measured every frame (reads only, no layout writes)
        const measure = () => {
          const c = canvas.getBoundingClientRect();
          if (slot) {
            const r = slot.getBoundingClientRect();
            art.setAnchor(r.left + r.width / 2 - c.left, r.top + r.height / 2 - c.top);
          }
          if (tiers.length) {
            const vh = window.innerHeight || 900;
            let best: DOMRect | null = null;
            for (const el of tiers) {
              const r = el.getBoundingClientRect();
              if (!best || Math.abs(r.top + r.height / 2 - vh / 2) < Math.abs(best.top + best.height / 2 - vh / 2)) best = r;
            }
            if (best) art.setTier(best.left + best.width / 2 - c.left, best.top + best.height / 2 - c.top, best.width, best.height);
          }
          requestAnimationFrame(measure);
        };
        measure();
        const onScroll = () => {
          if (!raf) raf = requestAnimationFrame(update);
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll);
        update();
      }

      // --- Copy: the agent prompt, or an install command ---
      const toast = document.getElementById("toast");
      const toastTitle = document.getElementById("toast-title");
      const toastSub = document.getElementById("toast-sub");
      const toastClose = document.getElementById("toast-close");
      let hideTimer = 0;
      async function copyText(text: string): Promise<boolean> {
        if (!text) return false;
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          return false;
        }
      }
      function show(title: string, sub: string) {
        if (!toast || !toastTitle || !toastSub) return;
        toastTitle.textContent = title;
        toastSub.textContent = sub;
        toast.hidden = false;
        window.clearTimeout(hideTimer);
        hideTimer = window.setTimeout(() => { toast.hidden = true; }, 9000);
      }
      toastClose?.addEventListener("click", () => { if (toast) toast.hidden = true; });
      for (const el of Array.from(document.querySelectorAll<HTMLButtonElement>(".add-agent"))) {
        el.addEventListener("click", async () => {
          const ok = await copyText(el.dataset.prompt ?? "");
          show(
            ok ? "Copied. Paste it into your agent." : "Copy blocked by the browser.",
            ok ? "Codex, Claude Code or Cursor fetch the install guide and walk you through setup." : "Open the docs for the install command.",
          );
                  });
      }
    </script>
  </body>
</html>
