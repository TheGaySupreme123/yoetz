    <script>
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const hasIO = typeof IntersectionObserver !== "undefined";

      // --- Install tabs: a click copies the command and confirms it ---
      const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".inst-tab:not(.agent)"));
      const toast = document.getElementById("copy-toast");
      const toastCmd = document.getElementById("copy-toast-cmd");
      const nsTitle = document.getElementById("ns-title");
      const nsSteps = document.getElementById("ns-steps");
      const nsFoot = document.getElementById("ns-foot");
      const nsClose = document.getElementById("ns-close");
      const SETUP_TIME = "About two to three minutes.";
      const HOST_NOTE =
        "Setup connects Codex. For Claude Code or Cursor, run `yoetz integrate claude plugin preview` or `yoetz integrate cursor plugin preview` afterwards.";
      // Steps may carry `code` spans marked with backticks; everything is built as text nodes.
      function fillInline(el: HTMLElement, text: string) {
        el.replaceChildren();
        text.split("`").forEach((part, i) => {
          if (!part) return;
          if (i % 2 === 1) {
            const code = document.createElement("code");
            code.textContent = part;
            el.appendChild(code);
          } else {
            el.appendChild(document.createTextNode(part));
          }
        });
      }
      async function copyText(text: string): Promise<boolean> {
        if (!text) return false;
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          return false;
        }
      }
      function showNextSteps(title: string, steps: string[], command?: string, foot?: string) {
        if (!toast || !toastCmd || !nsTitle || !nsSteps || !nsFoot) return;
        nsTitle.textContent = title;
        toastCmd.textContent = command ?? "";
        toastCmd.hidden = !command;
        nsSteps.replaceChildren();
        for (const step of steps) {
          const li = document.createElement("li");
          fillInline(li, step);
          nsSteps.appendChild(li);
        }
        if (foot) fillInline(nsFoot, foot);
        nsFoot.hidden = !foot;
        toast.hidden = false;
      }
      nsClose?.addEventListener("click", () => {
        if (toast) toast.hidden = true;
      });
      for (const tab of tabs) {
        tab.addEventListener("click", async () => {
          const cmd = tab.dataset.command ?? "";
          if (!cmd) return;
          const copied = await copyText(cmd);
          const steps = tab.dataset.key === "pypi"
            ? [
                "Paste the command into your terminal and press Enter to install.",
                `Run \`yoetz\` to start setup, and answer its questions. ${SETUP_TIME}`,
                HOST_NOTE,
              ]
            : [
                "Paste the command into your terminal and press Enter. `npx yoetz` installs Yoetz and starts setup.",
                `Answer setup’s questions in your terminal. ${SETUP_TIME}`,
                HOST_NOTE,
              ];
          showNextSteps(copied ? "Copied. Run it in your terminal." : "Copy this command, then run it in your terminal.", steps, cmd);
        });
      }

      // --- Manual install disclosure ---
      const manualToggle = document.getElementById("manual-toggle");
      const manualPanel = document.getElementById("manual-panel");
      manualToggle?.addEventListener("click", () => {
        if (!manualPanel) return;
        const open = manualPanel.hidden;
        manualPanel.hidden = !open;
        manualToggle.setAttribute("aria-expanded", String(open));
        manualToggle.classList.toggle("open", open);
      });

      // --- Copy: agent setup prompt ---
      const agentBtn = document.getElementById("agent-copy");
      const agentLabel = document.getElementById("agent-copy-label");
      const agentDefaultLabel = agentLabel?.textContent ?? "";
      let agentTimer: ReturnType<typeof setTimeout>;
      agentBtn?.addEventListener("click", async () => {
        const prompt = agentBtn.dataset.command ?? "";
        const copied = await copyText(prompt);
        showNextSteps(
          copied ? "Copied. Now paste it into your agent." : "Copy this prompt, then paste it into your agent.",
          [
            "Open Codex, Claude Code, or Cursor and paste the prompt into the chat. Send it.",
            "Your agent installs Yoetz and hands you the terminal for setup’s questions.",
            `Answer them in your terminal. ${SETUP_TIME}`,
          ],
          copied ? undefined : prompt,
          "Any other MCP agent works too, with nothing else installed."
        );
        if (!copied) return;
        if (agentLabel) agentLabel.textContent = "Copied to your clipboard";
        agentBtn.classList.add("copied");
        clearTimeout(agentTimer);
        agentTimer = setTimeout(() => {
          if (agentLabel) agentLabel.textContent = agentDefaultLabel;
          agentBtn.classList.remove("copied");
        }, 2000);
      });

      // --- Terminal replay ---
      const term = document.getElementById("term");
      const cursor = document.getElementById("term-cursor");
      if (term && cursor) {
        let lines = Array.from(term.querySelectorAll<HTMLElement>(".tl"));
        const card = term.closest<HTMLElement>(".term-card");
        const titleEl = card?.querySelector<HTMLElement>(".term-title");
        const logoEl = card?.querySelector<HTMLImageElement>(".term-host");
        type TermScriptData = {
          title: string;
          hostName?: string;
          logo?: string;
          dark?: boolean;
          lines: { pre?: string; preC?: string; op?: string; rest?: string; restC?: string; finding?: boolean; ts?: number; d?: number }[];
        };
        let scripts: TermScriptData[] = [];
        try {
          scripts = JSON.parse(document.getElementById("term-scripts")?.textContent ?? "[]");
        } catch {
          scripts = [];
        }
        let scriptIdx = 0;
        let played = false;
        // Swap the server-rendered transcript for the chosen script's lines.
        const buildScript = (idx: number) => {
          const s = scripts[idx];
          if (!s) return;
          for (const l of lines) l.remove();
          const frag = document.createDocumentFragment();
          for (const ln of s.lines) {
            const div = document.createElement("div");
            div.hidden = true;
            div.dataset.d = String(ln.d ?? 180);
            if (ln.pre || ln.op || ln.rest) {
              div.className = "tl" + (ln.finding ? " tl-finding" : "");
              if (ln.ts) div.dataset.ts = String(ln.ts);
              const pre = document.createElement("span");
              pre.className = "tl-pre";
              pre.style.color = ln.preC ?? "#64748b";
              pre.textContent = ln.pre ?? "";
              div.appendChild(pre);
              if (ln.op) {
                const op = document.createElement("span");
                op.className = "tl-op";
                op.textContent = ln.op;
                div.appendChild(op);
              }
              const rest = document.createElement("span");
              rest.className = "tl-rest";
              rest.style.color = ln.restC ?? "#94a3b8";
              rest.textContent = ln.rest ?? "";
              div.appendChild(rest);
            } else {
              div.className = "tl tl-gap";
            }
            frag.appendChild(div);
          }
          term.insertBefore(frag, cursor);
          lines = Array.from(term.querySelectorAll<HTMLElement>(".tl"));
          if (titleEl) titleEl.textContent = `${s.hostName ?? ""} · ${s.title}`;
          if (logoEl && s.logo) {
            logoEl.src = s.logo;
            logoEl.classList.toggle("invert", Boolean(s.dark));
          }
        };
        if (reduced || !hasIO) {
          for (const l of lines) l.hidden = false;
          cursor.hidden = false;
        } else {
          for (const l of lines) l.hidden = true;
          const scrollEnd = () => {
            term.scrollTop = term.scrollHeight;
          };
          // Every line writes itself out, one at a time: speech types at
          // human pace, tool/yoetz output at a brisker machine pace.
          const typeLine = (line: HTMLElement, done: () => void) => {
            const rest = line.querySelector<HTMLElement>(".tl-rest");
            const full = rest?.textContent ?? "";
            const ts = Number(line.dataset.ts || 7);
            const d = Number(line.dataset.d || 180);
            if (!rest || !full) {
              line.hidden = false;
              scrollEnd();
              setTimeout(done, d);
              return;
            }
            rest.textContent = "▌";
            line.hidden = false;
            scrollEnd();
            let j = 0;
            const tick = () => {
              j += Math.random() < 0.25 ? 2 : 1;
              rest.textContent = full.slice(0, j) + (j < full.length ? "▌" : "");
              scrollEnd();
              if (j < full.length) setTimeout(tick, ts * (0.55 + Math.random() * 0.9));
              else setTimeout(done, d);
            };
            setTimeout(tick, 60);
          };
          // Replay from the top only when the visitor has actually left the
          // terminal and comes back after it has been idle for a while.
          const REPLAY_AFTER_MS = 10000;
          let playing = false;
          let finishedAt = 0;
          let awayFromView = true;
          const play = () => {
            card?.classList.add("playing");
            let i = 0;
            const next = () => {
              if (i >= lines.length) {
                card?.classList.remove("playing");
                cursor.hidden = false;
                scrollEnd();
                playing = false;
                finishedAt = Date.now();
                return;
              }
              typeLine(lines[i++], next);
            };
            next();
          };
          const start = () => {
            if (playing) return;
            playing = true;
            awayFromView = false;
            // A different script each visit: random on the first play,
            // never the one just shown on a replay.
            if (scripts.length > 0) {
              let idx = Math.floor(Math.random() * scripts.length);
              if (played && scripts.length > 1 && idx === scriptIdx) idx = (idx + 1) % scripts.length;
              scriptIdx = idx;
              played = true;
              buildScript(idx);
            }
            for (const l of lines) l.hidden = true;
            cursor.hidden = true;
            term.scrollTop = 0;
            setTimeout(play, 500);
          };
          const io = new IntersectionObserver(
            (entries) => {
              const visible = entries.some((e) => e.isIntersecting);
              if (!visible) {
                if (!playing) awayFromView = true;
                return;
              }
              if (awayFromView && (finishedAt === 0 || Date.now() - finishedAt > REPLAY_AFTER_MS)) start();
            },
            { threshold: 0.3 }
          );
          io.observe(term);
        }
      }

      // --- Footer receipt easter egg: the visitor's own session ---
      const rcDate = document.getElementById("rc-date");
      const rcActor = document.getElementById("rc-actor");
      const rcTz = document.getElementById("rc-tz");
      const rcTime = document.getElementById("rc-time");
      if (rcDate && rcActor && rcTz && rcTime) {
        const now = new Date();
        rcDate.textContent = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
        const ua = navigator.userAgent;
        const browser = /edg\//i.test(ua) ? "edge" : /firefox/i.test(ua) ? "firefox" : /chrome|crios/i.test(ua) ? "chrome" : /safari/i.test(ua) ? "safari" : "browser";
        const os = /iphone|ipad/i.test(ua) ? "ios" : /android/i.test(ua) ? "android" : /mac/i.test(ua) ? "macos" : /win/i.test(ua) ? "windows" : /linux/i.test(ua) ? "linux" : "somewhere";
        rcActor.textContent = `visitor:${browser}_on_${os}`;
        try {
          rcTz.textContent = `${now.toTimeString().slice(0, 5)} · ${Intl.DateTimeFormat().resolvedOptions().timeZone}`;
        } catch {
          rcTz.textContent = now.toTimeString().slice(0, 5);
        }
        const update = () => {
          rcTime.textContent = `${Math.max(1, Math.round(performance.now() / 1000))}s`;
        };
        update();
        setInterval(update, 1000);
      }

    </script>
  </body>
</html>
