    <!-- Footer -->
    <footer class="ds-footer">
      <div style="padding: 44px 0 8px;">
        <div class="receipt-card">
          <div class="rc-head">
            <img src="/assets/yoetz-mark.png" alt="" />
            <span>receipt · yoetz.dev · <span id="rc-date">today</span></span>
          </div>
          <div class="rc-body">
            <div class="rc-line"><span class="k">task</span><span>read yoetz.dev to the very bottom</span></div>
            <div class="rc-line"><span class="k">actor</span><span id="rc-actor">visitor:you</span></div>
            <div class="rc-line"><span class="k">local_frontier</span><span id="rc-tz">your timezone</span></div>
            <div class="rc-line"><span class="k">obligations</span><span>1 of 1 satisfied · reach_the_footer (you are here)</span></div>
            <div class="rc-line"><span class="k">evidence</span><span>time_on_page: <span id="rc-time">a while</span> · scroll_depth: 100%</span></div>
            <div class="rc-line"><span class="k">findings</span><span>fnd-01 · curiosity_detected · priority fun · disposition: appreciated</span></div>
            <div class="rc-line hl"><span class="k">conclusion</span><span>visitor_had_fun · coverage bounded to this footer · <span class="nowrap">thanks for scrolling</span></span></div>
          </div>
        </div>
      </div>
      <div class="ds-footer-inner">
        <div class="ds-footer-brand">
          <img src="/assets/yoetz-mark.png" alt="" style="width: auto; height: 20px;" />
          <span>© 2026 Yoetz. Apache-2.0. · support@yoetz.dev</span>
        </div>
        <div class="ds-footer-links">
          <a href={GITHUB} target="_blank" rel="noopener">GitHub</a>
          <span class="ds-footer-dot"></span>
          <a href={PYPI} target="_blank" rel="noopener">PyPI</a>
          <span class="ds-footer-dot"></span>
          <a href={NPM} target="_blank" rel="noopener">npm</a>
          <span class="ds-footer-dot"></span>
          <a href={`${GITHUB}/blob/main/SECURITY.md`} target="_blank" rel="noopener">Security</a>
          <span class="ds-footer-dot"></span>
          <a href={`${GITHUB}/blob/main/CONTRIBUTING.md`} target="_blank" rel="noopener">Contributing</a>
          <span class="ds-footer-dot"></span>
          <a href={`${GITHUB}/blob/main/CHANGELOG.md`} target="_blank" rel="noopener">Changelog</a>
        </div>
      </div>
